{
  "expo": {
    "name": "Sovereign Edge",
    "slug": "sovereign-edge",
    "version": "0.2.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fs.sovereign.edge",
      "supportsTablet": true,
      "appleTeamId": "8CJGS4873L"
    },
    "android": {
      "package": "fs.sovereign.edge",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f7f5f0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production"
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "This lets you ask the assistant to create, update, delete, or look up events on your own calendar."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "This lets you ask the assistant to turn on the flashlight.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f5f0",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#15100a"
          }
        }
      ]
    ]
  }
}
