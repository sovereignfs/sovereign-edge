{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sovereign Edge",
  "version": "0.1.0",
  "identifier": "fs.sovereign.edge.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite dev",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sovereign Edge",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMTNCNTJFQzhFOUI2QjEKUldTeHR1bklMclVUWTQ4YnJWd2JWMThOcnFaQlR0WkozRW9XczNYdlZKQXVTTVNBcEt4TTNvbmgK",
      "endpoints": [
        "https://github.com/sovereignfs/sovereign-edge/releases/latest/download/latest.json"
      ]
    }
  }
}
