# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects — continuous native generation (CNG) is the source
# of truth; `expo prebuild` regenerates these from app.json + config plugins.
# See docs/research/0002-react-native-framework-choice.md.
/apps/mobile/ios
/apps/mobile/android

# Local native modules: their *source* is committed, their build output is not.
# The patterns above are anchored to the repo root, so they do not cover these.
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/ios/build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
release.keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
