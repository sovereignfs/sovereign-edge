{
  "registryVersion": 1,
  "connectors": [
    {
      "id": "fs.sovereign.weather-open-meteo",
      "submittedBy": {
        "name": "kasunben",
        "contact": "sovereign@rohr.openfs.io"
      },
      "manifest": {
        "manifestVersion": 1,
        "id": "fs.sovereign.weather-open-meteo",
        "name": "Open-Meteo Forecast",
        "version": "1.0.0",
        "summary": "Current temperature for a location, from Open-Meteo's free, no-key weather API.",
        "tier": 1,
        "platforms": ["ios", "android"],
        "tool": {
          "name": "current_temperature",
          "description": "Get the current temperature at a latitude/longitude.",
          "parameters": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "description": "Latitude in decimal degrees."
              },
              "longitude": {
                "type": "number",
                "description": "Longitude in decimal degrees."
              }
            },
            "required": ["latitude", "longitude"]
          }
        },
        "permissions": {
          "network": {
            "origins": ["https://api.open-meteo.com"]
          }
        },
        "request": {
          "method": "GET",
          "origin": "https://api.open-meteo.com",
          "path": [{ "literal": "v1" }, { "literal": "forecast" }],
          "query": {
            "latitude": { "slot": "latitude" },
            "longitude": { "slot": "longitude" },
            "current": { "literal": "temperature_2m" }
          }
        },
        "response": {
          "textFrom": "current.temperature_2m",
          "maxBytes": 65536
        },
        "pricing": { "model": "free" }
      }
    },
    {
      "id": "fs.sovereign.github-whoami",
      "submittedBy": {
        "name": "kasunben",
        "contact": "sovereign@rohr.openfs.io"
      },
      "manifest": {
        "manifestVersion": 1,
        "id": "fs.sovereign.github-whoami",
        "name": "GitHub Who Am I",
        "version": "1.0.0",
        "summary": "Looks up the GitHub username for the connector's own configured token.",
        "tier": 1,
        "platforms": ["ios", "android"],
        "tool": {
          "name": "github_whoami",
          "description": "Returns the GitHub username for the currently configured personal access token.",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        "permissions": {
          "network": {
            "origins": ["https://api.github.com"]
          },
          "credentials": [
            {
              "key": "authHeader",
              "label": "GitHub personal access token (full Authorization header value, e.g. \"Bearer ghp_...\")"
            }
          ]
        },
        "request": {
          "method": "GET",
          "origin": "https://api.github.com",
          "path": [{ "literal": "user" }],
          "headers": {
            "Authorization": { "credential": "authHeader" },
            "Accept": { "literal": "application/vnd.github+json" }
          }
        },
        "response": {
          "textFrom": "login",
          "maxBytes": 65536
        },
        "pricing": { "model": "free" }
      }
    }
  ]
}
