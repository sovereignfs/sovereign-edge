{
  "name": "sovereign-edge",
  "version": "0.1.19",
  "private": true,
  "description": "Sovereign Edge — a privacy-first, fully offline on-device AI companion. Workspace root: apps/mobile (shipping), apps/desktop (pending epic 9.1), packages/* (shared, unpublished).",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "prebuild": "pnpm --filter mobile prebuild",
    "test": "pnpm --filter mobile test",
    "test:watch": "pnpm --filter mobile test:watch",
    "typecheck": "pnpm --filter mobile typecheck",
    "lint": "pnpm --filter mobile lint",
    "lint:fix": "pnpm --filter mobile lint:fix",
    "check:offline": "pnpm --filter mobile check:offline",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  }
}
