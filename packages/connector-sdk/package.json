{
  "name": "@sovereignfs/connector-sdk",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/fixtures/*": "./src/fixtures/*"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'vitest run'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
